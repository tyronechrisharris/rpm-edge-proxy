{
  "version": 1,
  "log_level": "INFO",
  "status": {
    "listen": "127.0.0.1:9090"
  },
  "services": [
    {
      "name": "export-lane-1-rpm",
      "kind": "rpm_broadcast",
      "listen": ["172.26.0.33:1600"],
      "upstream": {
        "address": "172.26.0.32:1600",
        "source_ip": "172.26.0.51"
      },
      "allowed_clients": ["172.26.0.0/24"],
      "client_writes": "discard",
      "disconnect_clients_on_upstream_loss": true,
      "connect_timeout_seconds": 3,
      "reconnect_delay_seconds": 2,
      "queue_packets": 128,
      "required": true
    },
    {
      "name": "import-lane-2-rpm",
      "kind": "rpm_broadcast",
      "listen": ["172.26.0.65:1600"],
      "upstream": {
        "address": "172.26.0.64:1600",
        "source_ip": "172.26.0.51"
      },
      "allowed_clients": ["172.26.0.0/24"],
      "client_writes": "discard",
      "disconnect_clients_on_upstream_loss": true,
      "connect_timeout_seconds": 3,
      "reconnect_delay_seconds": 2,
      "queue_packets": 128,
      "required": true
    }
  ]
}
