{
  "version": 1,
  "log_level": "INFO",
  "status": {
    "listen": "0.0.0.0:9090"
  },
  "services": [
    {
      "name": "lane-rpm",
      "kind": "rpm_broadcast",
      "listen": ["0.0.0.0:1600"],
      "upstream": {
        "address": "192.168.2.3:1600"
      },
      "client_writes": "discard",
      "disconnect_clients_on_upstream_loss": true,
      "connect_timeout_seconds": 3,
      "reconnect_delay_seconds": 2,
      "queue_packets": 32,
      "required": true
    }
  ]
}
